# ==============================================================================
# CHADUVU-GURU .gitignore
# ==============================================================================

# ============ SECRETS & CREDENTIALS ============
.env
serviceAccountKey.json
firebase-credentials.json
*.pem
*.key

# ============ PYTHON ============
# Virtual environments
venv/
env/
ENV/
.venv

# Python cache & compiled files
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.coverage
htmlcov/

# Distribution / packaging
build/
develop-eggs/
dist/
downloads/

# Test files (temporary scripts for debugging)
/check_models.py
/test_quota.py
/find_working_model.py
/simple_test.py
/test_*.py
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ============ USER DATA & UPLOADS ============
uploads/
hyperframes_engine/outputs/
*.pdf
chapterdata/chap_extraction.json
temp/
tmp/

# ============ REGENERATABLE CACHES ============
bm25_indices/
chpchunks/
summary/
backend/app/orchestrator_test/test_outputs/
backend/app/services/new_rag/outputs/
_query_debug.json

# Generated test-run output (real student query/answer data from local test
# harnesses, not code) - the harness scripts themselves stay tracked, only
# their per-run JSON output is excluded.
terminal_test/outputs/
backend/app/services/question_pipeline/evaluation/outputs/

# ============ SYSTEM FILES ============
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
.idx/
*.swp
*.swo
*~

# ============ LOGS & TEMP FILES ============
*.log
ans.txt
*.tmp
logs/

# ============ BACKUPS ============
Backups/
*.backup
*.bak

# ============ AI ASSISTANT FILES ============
.gemini/
docs/*
!docs/APPLICATION_WORKFLOW.md
!docs/workflow.html

# ============ NODE (if using) ============
node_modules/
package-lock.json
yarn.lock

# ============ DATABASE ============
*.db
*.sqlite
*.sqlite3

# Runtime chat interaction logs (real student query/answer data, not code)
consolidated_deployment_outputs/

# ============ KEEP THESE COMMITTED ============
!chapterdata/chapters_cache.json
!.gitignore
!README.md
