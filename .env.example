# ── Database & Vector Store Configuration ─────────────────────────────────────
# Qdrant URL (e.g. Local: http://localhost:6333 or Qdrant Cloud URL)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=textbooks_v2

# Supabase database config
# IMPORTANT: if left unset, the code falls back to a hardcoded production
# Supabase project - always set these explicitly for local/dev work so you
# don't accidentally read or write shared production data.
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_anon_key_here

# Redis (optional - used for caching). If unreachable, the app automatically
# falls back to an in-memory cache (data lost on restart) instead of failing.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Google Cloud Storage bucket name for books
GCS_BUCKET_NAME=chaduvuguru-books

# ── Firebase (optional here) ───────────────────────────────────────────────────
# Firestore is normally configured via a serviceAccountKey.json file at the
# repo root instead (see README.md) - only set ONE of these if a file isn't
# convenient (e.g. some cloud deployments), pasting the full key JSON as a
# single-line string.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
# FIREBASE_CREDENTIALS={"type":"service_account",...}

# ── AI API Keys ─────────────────────────────────────────────────────────────
# OpenAI API configuration (https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# ── Text-To-Speech (TTS) Configuration ───────────────────────────────────────
# Sarvam AI Bulbul v3 (Get key at: https://dashboard.sarvam.ai)
SARVAM_API_KEY=your_sarvam_api_key_here

# Microsoft Azure TTS
AZURE_TTS_API_KEY=your_azure_api_key_here
AZURE_TTS_REGION=your_azure_region_here

# HuggingFace Token (For AI4Bharat IndicTTS)
HUGGINGFACE_TOKEN=your_huggingface_token_here

# ── HyperFrame async video pipeline (DronaX - DigitalOcean Platform.pdf) ──────
# Real Redis is required here - unlike the cache above, the job queue must NOT
# silently fall back to memory (see backend/redis/client.py). Point at the
# same Redis as above; REDIS_URL takes priority over REDIS_HOST/PORT/PASSWORD
# if both are set.
# REDIS_URL=redis://localhost:6379/0

# hyperframes_service split (already deployed independently) - the API calls
# it over HTTP for the fast HTML-compile path; the worker runs its own copy
# internally instead (see hyperframe-worker/entrypoint.sh) and does not need
# this var set.
HYPERFRAMES_SERVICE_URL=http://localhost:8001

# hyperframe-controller only - real DigitalOcean mode (CONTROLLER_MODE=digitalocean).
# Leave CONTROLLER_MODE=local (the default) for docker-compose.local.yml testing.
# DO_API_TOKEN=your_restricted_do_token_here   # Droplet create/read/delete only, Part W
# DO_REGION=blr1
# DO_WORKER_SIZE=c-2vcpu-4gb
# DO_WORKER_SNAPSHOT_ID=your_golden_image_snapshot_id
# DO_VPC_UUID=
# DO_WORKER_IMAGE=registry.digitalocean.com/dronax-registry/hyperframe-worker:latest
